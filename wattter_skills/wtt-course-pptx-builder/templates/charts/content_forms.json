{
  "_doc": "内容形态 → 模板匹配字典。forms = 封闭词表定义（字典 key）；chart_tags = chart_id → 形态映射。dimensions 可用 min_items/max_items、requires_data、requires_cue_any 排除显然不合适的 chart 候选。被 match_content_forms.py / validate_chart_mappings.py / Strategist 共享读取。新增形态或新 chart 只改本文件。",
  "version": 1,
  "dimensions": {
    "relationship": [
      "parallel",
      "sequence",
      "orthogonal",
      "hierarchy",
      "cycle",
      "radial",
      "special"
    ],
    "has_data": [
      true,
      false
    ]
  },
  "forms": {
    "points_2": {
      "relationship": "parallel",
      "count": 2,
      "has_data": false,
      "slots": 2,
      "when": "2 个平级并列要点",
      "not_when": "双栏多维对比（compare_2col）；利弊（pros_cons）"
    },
    "points_3": {
      "relationship": "parallel",
      "count": 3,
      "has_data": false,
      "slots": 3,
      "when": "3 个平级并列要点",
      "not_when": "3 步递进（flow_linear）"
    },
    "points_4": {
      "relationship": "parallel",
      "count": 4,
      "has_data": false,
      "slots": 4,
      "when": "4 个平级并列要点",
      "not_when": "4 步递进（flow_linear）；2×2 正交（matrix_2x2）"
    },
    "points_5": {
      "relationship": "parallel",
      "count": 5,
      "has_data": false,
      "slots": 5,
      "when": "5 个平级并列要点",
      "not_when": "5 步递进（flow_linear）"
    },
    "points_6": {
      "relationship": "parallel",
      "count": 6,
      "has_data": false,
      "slots": 6,
      "when": "6 个平级并列要点",
      "not_when": "循环 6 段（flow_cycle）"
    },
    "compare_2col": {
      "relationship": "parallel",
      "count": 2,
      "has_data": false,
      "slots": 2,
      "when": "两个对象/方案多维度对比（传统 vs AI、A vs B）",
      "not_when": "多维正交分类（matrix_2x2）；单纯 2 要点（points_2）"
    },
    "compare_table": {
      "relationship": "parallel",
      "has_data": false,
      "when": "多对象按多维度逐行对比的表格",
      "not_when": "双栏叙事对比（compare_2col）"
    },
    "pros_cons": {
      "relationship": "parallel",
      "count": 2,
      "has_data": false,
      "slots": 2,
      "when": "利/弊、优/劣两栏对照",
      "not_when": "中性双栏对比（compare_2col）"
    },
    "kpi_metrics": {
      "relationship": "parallel",
      "has_data": true,
      "when": "多个关键指标数字卡（如 60%/40%/3x）",
      "not_when": "单一大数字（gauge）"
    },
    "flow_linear": {
      "relationship": "sequence",
      "has_data": false,
      "when": "线性递进步骤（识别→拆解→生成→验证）",
      "not_when": "循环（flow_cycle）；分支决策"
    },
    "flow_cycle": {
      "relationship": "cycle",
      "has_data": false,
      "when": "闭环循环步骤（PDCA、飞轮）",
      "not_when": "线性（flow_linear）"
    },
    "timeline": {
      "relationship": "sequence",
      "has_data": false,
      "when": "时间轴/路线图/旅程的先后节点",
      "not_when": "无时序的并列（points_N）"
    },
    "steps_ascending": {
      "relationship": "sequence",
      "has_data": false,
      "when": "逐级上升的台阶/阶梯递进",
      "not_when": "平级流程（flow_linear）"
    },
    "matrix_2x2": {
      "relationship": "orthogonal",
      "count": 4,
      "has_data": false,
      "slots": 4,
      "when": "两独立维度交叉分类（重要/紧急、成本/收益）",
      "not_when": "四项平级（points_4）"
    },
    "quadrant_data": {
      "relationship": "orthogonal",
      "has_data": true,
      "when": "两数值维度散点分象限",
      "not_when": "纯文本四象限（matrix_2x2）"
    },
    "pyramid": {
      "relationship": "hierarchy",
      "has_data": false,
      "when": "层级递进的金字塔/马斯洛式分层",
      "not_when": "平级要点（points_N）"
    },
    "tree": {
      "relationship": "hierarchy",
      "has_data": false,
      "when": "树状/组织/脑图式的层级展开",
      "not_when": "线性流程（flow_linear）"
    },
    "treemap_proportion": {
      "relationship": "hierarchy",
      "has_data": true,
      "when": "按占比切分的层级矩形",
      "not_when": "纯结构树（tree）"
    },
    "hub_spoke": {
      "relationship": "radial",
      "has_data": false,
      "when": "中心辐射/一轮多瓣（一核心 N 分支）",
      "not_when": "并列卡（points_N）；循环（flow_cycle）"
    },
    "venn": {
      "relationship": "special",
      "has_data": false,
      "when": "集合交并关系（2-3 圈韦恩）",
      "not_when": "普通对比（compare_2col）"
    },
    "fishbone": {
      "relationship": "special",
      "has_data": false,
      "when": "因果鱼骨图（结果 + 多类原因）",
      "not_when": "并列原因（points_N）"
    },
    "architecture": {
      "relationship": "special",
      "has_data": false,
      "when": "系统架构/模块组成/客户端-服务端拓扑",
      "not_when": "业务流程（flow_linear）"
    },
    "agenda": {
      "relationship": "special",
      "has_data": false,
      "when": "议程/目录清单",
      "not_when": "并列要点（points_N）"
    },
    "team": {
      "relationship": "special",
      "has_data": false,
      "when": "团队/角色花名册",
      "not_when": "并列要点（points_N）"
    },
    "table": {
      "relationship": "special",
      "has_data": false,
      "when": "通用信息/咨询/特征/财务表格",
      "not_when": "对比表（compare_table）"
    },
    "gantt": {
      "relationship": "sequence",
      "has_data": true,
      "when": "项目排期甘特/进度表",
      "not_when": "无时间维度的表格（table）"
    },
    "bar": {
      "relationship": "sequence",
      "has_data": true,
      "when": "单系列数值排序对比（柱状）",
      "not_when": "多系列分组（bar_grouped）；构成（composition_pie）"
    },
    "bar_grouped": {
      "relationship": "sequence",
      "has_data": true,
      "when": "2-4 系列同维度并排对比（YoY/QoQ）",
      "not_when": "单系列（bar）；构成（bar_stacked）"
    },
    "bar_stacked": {
      "relationship": "sequence",
      "has_data": true,
      "when": "每类内部构成堆叠",
      "not_when": "独立系列并排（bar_grouped）"
    },
    "trend_line": {
      "relationship": "sequence",
      "has_data": true,
      "when": "数值随时间/序号变化趋势",
      "not_when": "纯结构无数据（flow_linear/timeline）"
    },
    "trend_area": {
      "relationship": "sequence",
      "has_data": true,
      "when": "强调累积体量的趋势",
      "not_when": "纯方向无体量（trend_line）"
    },
    "composition_pie": {
      "relationship": "special",
      "has_data": true,
      "when": "整体构成占比（饼/环）",
      "not_when": "趋势（trend_line）；对比（bar）"
    },
    "correlation_scatter": {
      "relationship": "orthogonal",
      "has_data": true,
      "when": "两变量相关散点",
      "not_when": "分象限（quadrant_data）"
    },
    "radar": {
      "relationship": "special",
      "has_data": true,
      "when": "多维度均衡雷达",
      "not_when": "2 维（quadrant_data）"
    },
    "gauge": {
      "relationship": "special",
      "has_data": true,
      "when": "单值仪表/进度",
      "not_when": "多指标（kpi_metrics）"
    },
    "heatmap": {
      "relationship": "orthogonal",
      "has_data": true,
      "when": "两维度密度热力",
      "not_when": "散点（correlation_scatter）"
    },
    "distribution_box": {
      "relationship": "special",
      "has_data": true,
      "when": "分布箱线",
      "not_when": "单值（gauge）"
    },
    "waterfall": {
      "relationship": "sequence",
      "has_data": true,
      "when": "bridge/瀑布拆解（初值→增减→终值）",
      "not_when": "并排柱（bar_grouped）"
    },
    "pareto": {
      "relationship": "special",
      "has_data": true,
      "when": "帕累托 80/20（柱+累计线）",
      "not_when": "纯柱（bar）"
